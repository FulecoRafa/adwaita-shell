#!/bin/sh
# Runs the host command this link is named after, outside the sandbox:
# the services' tools (pw-dump, wpctl, nmcli, ...) and the apps the shell
# launches live on the host. --watch-bus: if this process dies, even by
# SIGKILL, the host one is killed too, so long-running followers
# (pw-dump --monitor) never outlive the services. The sandbox's working
# directory (/app/share/adwaita-shell) does not exist on the host.
exec flatpak-spawn --host --watch-bus --directory="$HOME" "${0##*/}" "$@"
